/*
// tap: calls single quote | double tap calls double quotes // not using it becuase I want to get used to home row mods
ZMK_BEHAVIOR(tapdance_APOS, tap_dance,
    bindings = <&kp APOS>, <&kp LS(APOS)>;
)
*/

// hold: first argument | tap: second argument
ZMK_BEHAVIOR(holdtap_sk, hold_tap,
    flavor = "tap-preferred";
    tapping-term-ms = <280>;
    quick-tap-ms = <QUICK_TAP_MS>;
    require-prior-idle-ms = <150>;
    bindings = <&mo>, <&sk>;
    hold-trigger-on-release;
)

/ {
// TODO: Add hyper key as HRM
// TODO: Add PTAB and NTAB keys when I figure out how to avoid accidental key presses of outer pinky keys (e.g. prior idle time)
    keymap {
        compatible = "zmk,keymap";
        default_layer { // ColemakDHm
            bindings = <
               &kp Q         &kp W         &kp F              &kp P            &kp B                 &kp J         &kp L              &kp U            &kp Y            &kp APOS 
               &hml LCTRL A  &hml LALT R   &hml LGUI S        &hml LSHFT T     &kp G                 &kp M         &hmr RSHFT N       &hmr RGUI E      &hmr LALT I      &hmr RCTRL O
    ZOOMOUT    &kp Z         &kp X         &hml MEH C         &hml HYP D       &kp V                 &kp K         &hmr HYP H         &hmr_meh MEH 0   &tapdance_dot    &tapdance_qmark    ZOOMIN
                                           &lt UTIL ESC       &lt NAV SPACE    &kp TAB               &kp RET       &lt NUM BSPC       &holdtap_sk FUNC RSHFT
            >;
        };
        nav_layer { 
            bindings = <
            ___          ___          ___            ___             ___                   ___           &kp HOME          &kp UP          &kp END       &kp PAGE_UP 
            &kp LCTRL    &kp LALT     &kp LGUI       &kp LSHFT       ___                   ___           &kp LEFT          &kp DOWN        &kp RIGHT     &kp PAGE_DOWN
    BACK    ___          ___          &kp MEH        &kp HYP         ___                   ___           ___               ___             ___           ___             FWD
                                      ___            ___             ___                   &kp RET       &kp BSPC          &kp DEL
            >;
        }; 
        num_layer {
            bindings = <
            &kp STAR     &kp N7       &kp N8          &kp N9         &kp FSLH              ___           ___               ___             ___           ___ 
            &kp CARET    &kp N4       &kp N5          &kp N6         &kp PLUS              ___           &kp LSHFT         &kp LGUI        &kp LALT      &kp LCTRL
  &kp LPAR  &none        &kp N1       &kp N2          &kp N3         &kp MINUS             ___           &kp HYP           &kp MEH         ___           ___            &kp RPAR
                                      &kp DOT         &kp N0         &kp EQUAL             ___           ___               ___
            >;
        };
        func_layer {
            bindings = <
            &none        &kp F7       &kp F8          &kp F9          ___                   ___           ___               ___             ___           ___
            &kp F12      &kp F4       &kp F5          &kp F6          ___                   ___           &kp LSHFT         &kp LGUI        &kp LALT      &kp LCTRL 
    ___     &kp F11      &kp F1       &kp F2          &kp F3          ___                   ___           &kp HYP           &kp MEH         ___           ___             ___
                                      ___             &kp F10         ___                   ___           ___               ___
            >;
        };
        util_layer {
            bindings = <
                    &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1   &bt BT_SEL 0    &bt BT_CLR             ___           ___               &kp C_VOL_UP    ___           LOCK
                    &kp LCTRL    &kp LALT     &kp LGUI       &kp LSHFT       ___                    ___           ___               &kp C_VOL_DN    ___           ___ 
    &kp C_PREV      ___          ___          &kp MEH        &kp HYP         ___                    ___           ___               &kp C_MUTE      ___           ___    &kp C_NEXT
                                              ___            ___             ___                    ___           &kp C_PP          ___
            >;
        };  
    };
};
    
